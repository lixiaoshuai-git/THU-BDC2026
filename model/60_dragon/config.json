{
    "sequence_length": 60,
    "model_type": "transformer",
    "d_model": 256,
    "nhead": 4,
    "num_layers": 3,
    "dim_feedforward": 512,
    "batch_size": 4,
    "num_epochs": 50,
    "learning_rate": 1e-05,
    "dropout": 0.3,
    "feature_num": "dragon",
    "max_grad_norm": 5.0,
    "pairwise_weight": 1,
    "base_weight": 1.0,
    "top5_weight": 2.0,
    "use_strategy_features": false,
    "strategy_sample_weight": 2.0,
    "strategy_score_threshold": 4,
    "loss_function": "lambdarank",
    "label_type": "rank",
    "feature_selection_keep": 100,
    "output_dir": "./model/60_dragon",
    "data_path": "./data"
}